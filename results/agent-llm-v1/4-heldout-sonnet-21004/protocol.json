    "buy_parent": {
      "kind": "buy_parent",
      "quantity": 40,
      "instruction": "Buy a 40-lot parent order by the session deadline. Seek low execution cost relative to the initial midpoint. Do not sell or exceed the parent quantity. Balance completion and cost; report no claims about future prices."
    },
    "market_making": {
      "kind": "market_making",
      "inventory_limit": 30,
      "instruction": "Provide genuine two-sided liquidity and earn execution spread while keeping absolute inventory at or below 30 lots. You may reprice or cancel stale quotes. Aim for executions on both sides, rather than artificial turnover."
    }
  },
  "action_contract": "Return only a JSON object with actions (a list of at most 8 actions) and an optional short explanation. Actions: {\"type\":\"hold\"}, {\"type\":\"cancel\",\"order_id\":positive_integer}, {\"type\":\"market\",\"side\":\"buy\"|\"sell\",\"qty\":positive_integer}, or {\"type\":\"limit\",\"side\":\"buy\"|\"sell\",\"qty\":positive_integer,\"price\":positive_integer}. Explanations describe the action briefly; do not provide hidden reasoning. Each action advances simulated time by one second.",
